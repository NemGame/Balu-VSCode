/* Types
number - long double
string - wstring
char   - wchar_t
byte   - unsigned char
bool   - boolean
any    - can switch between types in runtime
auto   - automatically finds the type; stays the same type
void   - nothing
null   - null

array  - stack
*/
struct CustomType {
    x:number;
};;;

